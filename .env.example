# OpenRouter configuration
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model configuration (comma-separated fallback chain, first = primary)
LLM_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-haiku

# Optional metadata OpenRouter uses for attribution/rankings
APP_NAME=Kids Fashion Assistant
APP_URL=http://localhost:8501

# Database
DATABASE_URL=sqlite:///./data/kidsfashion.db

# API
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
